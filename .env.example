GEMINI_API_KEY=your_api_key_di_sini
GEMINI_API_KEYS=key1,key2,key3
GEMINI_MODEL=gemini-3.6-flash
PORT=3000

# URL environment internal (ganti sesuai environment Anda)
AMARTHA_GATEWAY=
AMARTHA_QUERY_URL=
AMARTHA_LOAN_BASE=

# 1 = paksa semua ekstraksi berjalan sinkron (untuk serverless / Vercel)
SYNC_ONLY=1
# 1 = set atribut Secure pada cookie (wajib jika HTTPS)
COOKIE_SECURE=1